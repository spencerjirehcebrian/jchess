registry=https://registry.npmjs.org/

# typescript-eslint 8.65 declares a peer of typescript <6.1.0, and this project
# is on 7. The pairing works — lint and tsc both pass — but npm ci refuses the
# tree over the declaration alone, which broke every fresh clone and every
# container build. Drop this once typescript-eslint widens the range.
legacy-peer-deps=true
